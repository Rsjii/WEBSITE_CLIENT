# ── Frontend (Vite) configuration ────────────────────────────
# In dev you usually need NOTHING here: the Vite proxy forwards /api
# to the backend on :4000 (see vite.config.js), so the browser stays
# same-origin and the session cookie works automatically.

# Only set this for production, when the API is served from another origin.
# Example: VITE_API_URL=https://api.auratrade.com
VITE_API_URL=
