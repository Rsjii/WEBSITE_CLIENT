# ── AuraTrade backend configuration ──────────────────────────
# Copy this file to `.env` and fill in the blanks. The app RUNS WITHOUT
# any of the optional keys (emails print to the console, Google is hidden),
# so you can develop immediately and add keys when ready.

NODE_ENV=development
PORT=4000

# Where the frontend runs (used for CORS + password-reset links)
APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Session signing — REQUIRED for production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
COOKIE_NAME=aura_session

# Resend (https://resend.com) — sends OTP & password-reset emails.
# Leave blank in dev: codes/links print to the server console instead.
RESEND_API_KEY=
EMAIL_FROM=AuraTrade <onboarding@resend.dev>

# Inbox that receives public "Contact Us" form submissions from the landing page.
CONTACT_EMAIL=support@auratrade.com

# Google OAuth — Google Identity Services client ID.
# Create at https://console.cloud.google.com/apis/credentials (OAuth client,
# type "Web application"). Add http://localhost:5173 to Authorized JS origins.
GOOGLE_CLIENT_ID=

# OTP / reset policy
OTP_TTL_MIN=10
OTP_RESEND_COOLDOWN_SEC=60
OTP_MAX_ATTEMPTS=5
RESET_TTL_MIN=30

# Trading account pricing (wallet → account allocation)
ACCOUNT_PRICE=100
ACCOUNT_TICKET_FEE=10

# Deposit destinations shown in the Funds tab. Leave blank to show a
# "contact support" fallback instead of an address/QR for that method.
DEPOSIT_WALLET_USDT=
DEPOSIT_WALLET_BTC=
DEPOSIT_WALLET_ETH=
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_IBAN=
BANK_SWIFT=

# % of an account's total open cost credited to the referrer, every time
# someone they referred opens a trading account.
REFERRAL_COMMISSION_PERCENT=10
